  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u042D\u0442\u043E \u0434\u0435\u0440\u0435\u0432\u043E... \u041C\u044B
