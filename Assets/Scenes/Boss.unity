--- !u!114 &1471629784
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1471629782}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\"\u0421\u0430\u0448\u0430 \u0440\u0430\u0437\u0436\u0430\u043B \u043B\u0430\u0434\u043E\u043D\u044C.
    \u041D\u0430 \u043D\u0435\u0439 \u043B\u0435\u0436\u0430\u043B \u043C\u0430\u043C\u0438\u043D
    \u043A\u0443\u043B\u043E\u043D \u2014 \u0442\u043E\u0442 \u0441\u0430\u043C\u044B\u0439,
    \u0441 \u043A\u0440\u0430\u0441\u043D\u044B\u043C \u0441\u0435\u0440\u0434\u0446\u0435\u043C.
    \u041E\u043D \u0432\u0434\u0440\u0443\u0433 \u043F\u043E\u043D\u044F\u043B: \u0431\u0430\u0431\u043E\u0447\u043A\u0430,
    \u0447\u0442\u043E \u0432\u0435\u043B\u0430 \u0435\u0433\u043E \u0447\u0435\u0440\u0435\u0437
    \u0432\u0441\u0435 \u0438\u0441\u043F\u044B\u0442\u0430\u043D\u0438\u044F, \u0431\u044B\u043B\u0430
    \u0435\u044E. \u041D\u0435 \u043F\u0440\u0438\u0437\u0440\u0430\u043A\u043E\u043C,
    \u043D\u0435 \u0441\u043D\u043E\u043C. \u041F\u0440\u043E\u0441\u0442\u043E \u043B\u044E\u0431\u043E\u0432\u044C\u044E,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u043E\u0441\u0442\u0430\u043B\u0430\u0441\u044C
    \u0441 \u043D\u0438\u043C.\r\n\u041A\u0443\u043B\u043E\u043D \u0441\u0442\u0430\u043B
    \u0442\u0451\u043F\u043B\u044B\u043C \u0432 \u0435\u0433\u043E \u0440\u0443\u043A\u0435.
    \u0422\u0435\u043F\u0435\u0440\u044C \u043E\u043D \u0437\u043D\u0430\u043B \u2014
    \u0447\u0442\u043E\u0431\u044B \u0443\u0432\u0438\u0434\u0435\u0442\u044C \u043C\u0430\u043C\u0443,
    \u043D\u0435 \u043D\u0443\u0436\u043D\u0430 \u0432\u043E\u043B\u0448\u0435\u0431\u043D\u0430\u044F
    \u0431\u0430\u0448\u043D\u044F. \u0414\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E
    \u0437\u0430\u043A\u0440\u044B\u0442\u044C \u0433\u043B\u0430\u0437\u0430...
    \u0438 \u0432\u0441\u043F\u043E\u043C\u043D\u0438\u0442\u044C.\r\n\u0421\u0430\u0448\u0430
    \u0432\u044B\u0448\u0435\u043B \u043D\u0430 \u0441\u0432\u0435\u0442, \u043F\u0440\u0438\u0436\u0438\u043C\u0430\u044F
    \u043A \u0433\u0440\u0443\u0434\u0438 \u0435\u0434\u0438\u043D\u0441\u0442\u0432\u0435\u043D\u043D\u043E\u0435,
    \u0447\u0442\u043E \u0435\u0439 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C
    \u2014 \u043F\u0430\u043C\u044F\u0442\u044C, \u0441\u0442\u0430\u0432\u0448\u0443\u044E
    \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0441\u043C\u0435\u0440\u0442\u0438.\"\n\n\u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u0447\u0442\u043E \u043F\u0440\u043E\u0448\u043B\u0438 \u044D\u0442\u043E\u0442
    \u043F\u0443\u0442\u044C \u0434\u043E \u043A\u043E\u043D\u0446\u0430.\r\n\u0412\u044B
    \u043F\u043E\u043C\u043E\u0433\u043B\u0438 \u0421\u0430\u0448\u0435 \u043D\u0430\u0439\u0442\u0438
    \u0442\u043E, \u0447\u0442\u043E \u043D\u0435\u043B\u044C\u0437\u044F \u043F\u043E\u0442\u0435\u0440\u044F\u0442\u044C."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
