  m_Script: {fileID: 11500000, guid: a1419410cd88c8146acb123290ea04a8, type: 3}
  m_Name: StartDialogue
  m_EditorClassIdentifier: 
  DialogElements:
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u042F \u043D\u0435 \u0437\u043D\u0430\u044E, \u0432\u0435\u0440\u0438\u0448\u044C
      \u043B\u0438 \u0442\u044B \u0432 \u0447\u0443\u0434\u0435\u0441\u0430..."
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u041D\u043E \u0441\u0435\u0433\u043E\u0434\u043D\u044F \u044F \u0443\u0432\u0438\u0434\u0435\u043B
      \u0435\u0451.\r\n\u041C\u0430\u043C\u0430. \u0412 \u043E\u043A\u043D\u0435
      \u044D\u0442\u043E\u0439 \u0431\u0430\u0448\u043D\u0438."
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u041E\u043D\u0430 \u0443\u0448\u043B\u0430 \u043C\u0435\u0441\u044F\u0446
      \u043D\u0430\u0437\u0430\u0434.\r\n\u0418 \u0441 \u0442\u0435\u0445 \u043F\u043E\u0440
      \u043C\u0438\u0440 \u0441\u0442\u0430\u043B \u0441\u0435\u0440\u044B\u043C
      \u0438 \u043F\u0443\u0441\u0442\u044B\u043C."
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u041D\u043E \u0441\u0435\u0439\u0447\u0430\u0441...\r\n\u0421\u0435\u0439\u0447\u0430\u0441
      \u044F \u0437\u043D\u0430\u044E \u2014 \u043E\u043D\u0430 \u0442\u0430\u043C."
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u041C\u043E\u0436\u0435\u0442, \u044D\u0442\u043E \u043B\u043E\u0432\u0443\u0448\u043A\u0430.\r\n\u041C\u043E\u0436\u0435\u0442,
      \u044D\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u0441\u043E\u043D.\r\n\u041D\u043E
      \u044F \u0434\u043E\u043B\u0436\u0435\u043D \u043F\u043E\u043F\u0440\u043E\u0431\u043E\u0432\u0430\u0442\u044C."
  - PortretSprite: {fileID: -2576023137440582333, guid: a96a6615cde513449946a878c8244645, type: 3}
    DialogText: "\u041F\u043E\u043C\u043E\u0433\u0438 \u043C\u043D\u0435 \u0434\u043E\u0439\u0442\u0438
      \u0434\u043E \u0431\u0430\u0448\u043D\u0438.\r\n\u042F \u0434\u043E\u043B\u0436\u0435\u043D
      \u0435\u0451 \u043D\u0430\u0439\u0442\u0438..."
